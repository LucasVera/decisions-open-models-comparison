# Copy this file to .env, then edit the settings for the provider you want to run.
MODEL_PROVIDER=ollama

OLLAMA_MODEL=d1
# Optional suite: all, or comma-separated tags such as d1,tev1:4b,nimble
# Leave empty to evaluate only OLLAMA_MODEL.
OLLAMA_EVAL_MODELS=
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
